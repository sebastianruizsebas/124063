/*  Rod Achromatopsia Simulation Protocol
    Compares scotopic baseline vs rod achromatopsia conditions
    
    Author: Based on Publio et al. 2009
    Modified for CNS F25 Project 2
*/

load_file("nrngui.hoc")	

// ============================================================================
// GLOBAL SIMULATION PARAMETERS
// ============================================================================

// Condition flags
SCOTOPIC_BASELINE = 0      // 0 = Rod achromatopsia, 1 = Normal scotopic
ENABLE_CONES = 1           // Will be set to 0 for rod achromatopsia
A_BG = 0                   // Background current (pA) for mesopic/photopic stress
KR_COUPLING = 1            // Rod-rod coupling index (0-5)
KA_COUPLING = 1            // A2-bipolar coupling index (0-5)

// Gap junction conductance (nS) - direct control for coupling experiment
g_gap_rod = 0.1           // Rod-rod gap junction conductance (0-5 nS)
g_gap_a2 = 0.3            // A2-bipolar gap junction conductance (0-2 nS)

// Control panel variables (for single trial testing)
amp = 30                   // Flash amplitude (pA)
gihbar = 1.0              // gh conductance (nS)

// Simulation parameters
celsius = 23
v_init = -41.5
dt = 0.1
tstop = 5000              // 5 second trials
stim_init = 500           // Start stimulation at 500ms

// Noise parameters for realistic trials
POISSON_NOISE_ENABLED = 1     // Enable Poisson photon arrival variability
GAUSSIAN_NOISE_ENABLED = 1    // Enable intrinsic membrane noise
gaussian_noise_sigma = 0.5    // mV - justified by Field & Rieke 2002
noise_seed = 12345            // RNG seed for reproducibility

// Network parameters (reduced for computational efficiency)
nrodx = 20                // Reduced from 50
nrody = 20                // Reduced from 30
nconex = 4
nconey = 4
nrodbipx = 5              // Reduced from 10
nrodbipy = 5
nconebipx = 2
nconebipy = 2
na2x = 3
na2y = 3
nganx = 1
ngany = 1

rodtotal = nrodx*nrody
conetotal = nconex*nconey
biptotal = nrodbipx*nrodbipy + nconebipx*nconebipy
A2total = na2x*na2y
gantotal = nganx*ngany

// Convergence parameters
rodtobip = 2
conetobip = 1
conetorod = 4
rodbiptoa2 = 3
a2toconebip = 2
conebiptogan = 1

seed = 12345
MAXNUMBERCONNECTIONS = 50000
PROB = 0.5

// ============================================================================
// ANALYSIS PARAMETERS
// ============================================================================

objref spike_times, spike_count_vec
spike_times = new Vector()
spike_count_vec = new Vector()

// Trial data storage for statistics
objref trial_responses, trial_times
trial_responses = new Vector()  // Firing rates per trial
trial_times = new Vector()      // Time stamps

strdef output_filename
objref output_file

// LN model bipolar readout parameters
LN_FILTER_TAU1 = 10    // ms - fast component
LN_FILTER_TAU2 = 50    // ms - slow component  
LN_FILTER_WEIGHT = 0.6 // Relative weight of fast component
objref ln_filter_output, ln_response_vec
ln_filter_output = new Vector()
ln_response_vec = new Vector()

// Global vectors for coupling sweep
objref intensity_vec, g_gap_vec, g_gap_vec_robust

// ============================================================================
// LOAD TEMPLATES AND CREATE NETWORK
// ============================================================================

load_file("Rod.tem")
load_file("Cone.tem")		
load_file("Bip.tem")
load_file("A2.tem")
load_file("Ganglion.tem")

objref rod_bip[nrodbipx][nrodbipy], rod[nrodx][nrody], cone[nconex][nconey]
objref A2_cell[na2x][na2y], GAN[nganx][ngany], cone_bip[nconebipx][nconebipy]
objref brightcurr[nrodx][nrody], dimcurr[nrodx][nrody], input_cone[nconex][nconey]
objref random, prob
random = new Random(seed)
prob = new Random(seed)

// Noise generators
objref noise_rng_poisson, noise_rng_gaussian
noise_rng_poisson = new Random()
noise_rng_gaussian = new Random()

proc init_noise_generators() {
    noise_rng_poisson.MCellRan4(noise_seed)
    noise_rng_gaussian.MCellRan4(noise_seed + 1)
    noise_rng_gaussian.normal(0, gaussian_noise_sigma)
    print "Noise generators initialized with seeds"
}

// ============================================================================
// CELL CREATION
// ============================================================================

proc create_network() {
    print "Creating retinal network..."
    
    // Create Rods
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            rod[i][j] = new Rod()
        }
    }
    
    // Create Cones
    for i = 0, nconex-1 {
        for j = 0, nconey-1 {
            cone[i][j] = new Cone()
        }
    }
    
    // Create Rod bipolar cells
    for i = 0, nrodbipx-1 {
        for j = 0, nrodbipy-1 {
            rod_bip[i][j] = new Bip()
        }
    }
    
    // Create Cone bipolar cells
    for i = 0, nconebipx-1 {
        for j = 0, nconebipy-1 {
            cone_bip[i][j] = new Bip()
            cone_bip[i][j].soma.gkabar_IA(0.5) = 0
        }
    }
    
    // Create A2 amacrine cells
    for i = 0, na2x-1 {
        for j = 0, na2y-1 {
            A2_cell[i][j] = new A2()
        }
    }
    
    // Create Ganglion cells
    for i = 0, nganx-1 {
        for j = 0, ngany-1 {
            GAN[i][j] = new Ganglion()
        }
    }
    
    printf("Network created: %d rods, %d cones, %d bipolars, %d A2, %d ganglion\n", \
           rodtotal, conetotal, biptotal, A2total, gantotal)
}

// ============================================================================
// INPUT CURRENT INJECTION WITH POISSON NOISE
// ============================================================================

objref poisson_noise_vec[nrodx][nrody]

proc insert_rod_currents() { local flash_amp, bg_current, input_frac, actual_flash
    // $1 = flash amplitude (pA)
    // $2 = background current (pA)
    // $3 = fraction of rods receiving input (0-100%)
    
    flash_amp = $1
    bg_current = $2
    input_frac = $3
    
    InputNumber = (input_frac/100) * rodtotal
    printf("Injecting flash=%g pA + background=%g pA into %d/%d rods\n", \
           flash_amp, bg_current, InputNumber, rodtotal)
    
    // Initialize all rods with background current
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            rod[i][j].soma {
                brightcurr[i][j] = new IinjLT(0.5)
                brightcurr[i][j].del = stim_init
                brightcurr[i][j].ton = tstop - stim_init
                brightcurr[i][j].amp = 0
                brightcurr[i][j].ssI = bg_current  // Background/steady-state current
                
                dimcurr[i][j] = new IinjLTDim(0.5)
                dimcurr[i][j].del = stim_init
                dimcurr[i][j].ton = tstop - stim_init
                dimcurr[i][j].ssI = 0
                dimcurr[i][j].amp = 0
            }
        }
    }
    
    // Add flash with Poisson variability to random subset
    for k = 0, InputNumber-1 {
        ii = int(random.uniform(0, nrodx))
        if (ii >= nrodx) { ii = nrodx-1 }
        jj = int(random.uniform(0, nrody))
        if (jj >= nrody) { jj = nrody-1 }
        
        // Add Poisson noise if enabled
        if (POISSON_NOISE_ENABLED == 1) {
            // Poisson: mean = flash_amp, stdev = sqrt(flash_amp)
            actual_flash = noise_rng_poisson.poisson(flash_amp)
        } else {
            actual_flash = flash_amp
        }
        
        if (actual_flash >= 30) {
            brightcurr[ii][jj].amp = actual_flash
        } else {
            dimcurr[ii][jj].amp = actual_flash
        }
    }
}

// ============================================================================
// GAUSSIAN MEMBRANE NOISE INJECTION
// ============================================================================

objref gaussian_noise_stim[nrodx][nrody], noise_vec
noise_vec = new Vector()

proc add_gaussian_noise() { local i, j
    // Add continuous Gaussian noise to rod membranes
    
    if (GAUSSIAN_NOISE_ENABLED == 0) {
        return
    }
    
    printf("Adding Gaussian membrane noise (sigma=%g mV)\n", gaussian_noise_sigma)
    
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            rod[i][j].soma {
                // Create noise current using IClamp with time-varying amp
                // Check if already created to avoid re-creation
                if (!object_id(gaussian_noise_stim[i][j])) {
                    gaussian_noise_stim[i][j] = new IClamp(0.5)
                    gaussian_noise_stim[i][j].del = 0
                    gaussian_noise_stim[i][j].dur = tstop
                }
                // Noise amplitude scaled to produce ~sigma mV fluctuations
                // Typical rod input resistance ~1 GOhm, so 0.5 pA -> 0.5 mV
                gaussian_noise_stim[i][j].amp = noise_rng_gaussian.repick() 
            }
        }
    }
}

proc update_gaussian_noise() { local i, j
    // Update noise values each time step (called from FInitializeHandler)
    if (GAUSSIAN_NOISE_ENABLED == 0) {
        return
    }
    
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            gaussian_noise_stim[i][j].amp = noise_rng_gaussian.repick()
        }
    }
}

objref fih_noise
proc setup_noise_update() {
    fih_noise = new FInitializeHandler("update_gaussian_noise()")
}

// ============================================================================
// CONE INPUT CURRENTS
// ============================================================================

proc insert_cone_currents() {
    // Dark current in cones (disabled for rod achromatopsia)
    for i = 0, nconex-1 {
        for j = 0, nconey-1 {
            cone[i][j].soma {
                input_cone[i][j] = new IinjLT_cone(0.5)
                input_cone[i][j].amp = 0
                input_cone[i][j].del = 0
                input_cone[i][j].ton = tstop
            }
        }
    }
}

// ============================================================================
// CONDUCTANCE SWEEPS
// ============================================================================

proc set_rod_gh() { local gh_val
    // Set rod Ih conductance (nS)
    // $1 = gh value (0-10 nS range)
    gh_val = $1
    
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            rod[i][j].soma.ghbar_h = gh_val
        }
    }
    printf("Rod gh set to %g nS\n", gh_val)
}

proc set_rod_coupling() { local kr_index
    // Set rod-rod gap junction conductance directly
    // $1 = conductance value in nS (0-5 nS)
    
    g_gap_rod = $1
    
    printf("Rod coupling set to g=%g nS\n", g_gap_rod)
    
    // Note: actual gap junction implementation handled in gap.hoc
    // This sets the global variable that gap.hoc will read
}

proc set_A2_coupling() { local ka_index
    // Set A2-bipolar gap junction conductance directly
    // $1 = conductance value in nS (0-2 nS)
    
    g_gap_a2 = $1
    
    printf("A2 coupling set to g=%g nS\n", g_gap_a2)
}

// ============================================================================
// DISABLE CONE PATHWAY (ROD ACHROMATOPSIA)
// ============================================================================

proc disable_cone_pathway() {
    print "Disabling cone pathway (rod achromatopsia condition)..."
    
    // Set cone synaptic conductances to zero
    // This will be done when creating connections
    ENABLE_CONES = 0
    
    // Disable cone input current
    for i = 0, nconex-1 {
        for j = 0, nconey-1 {
            if (object_id(input_cone[i][j])) {
                input_cone[i][j].amp = 0
                input_cone[i][j].ssI = 0
            }
        }
    }
    
    print "Cone pathway disabled"
}

proc enable_cone_pathway() {
    print "Enabling cone pathway (scotopic baseline)..."
    ENABLE_CONES = 1
    print "Cone pathway enabled"
}

// ============================================================================
// NETWORK CONNECTIVITY
// ============================================================================

objref Glur2rodbip[nrodx][nrody], Glur2conebip[nconex][nconey]
objref Glurrodbip2A2[nrodbipx][nrodbipy], Glurconebip2GAN[nconebipx][nconebipy]
objref CellConection[MAXNUMBERCONNECTIONS], GAP_rod2cone[MAXNUMBERCONNECTIONS]
objref a2GAPa2[MAXNUMBERCONNECTIONS], GAP_A2conebip[MAXNUMBERCONNECTIONS]

NumberConections = 0
NUMBERGAPS = 0

proc connect_gaps() { local i, j
    // This is a placeholder - the actual gap junction setup
    // depends on the network topology defined elsewhere
    // For now, just note that gaps are created by:
    //   section1.insert_gap_here gap
    //   section2.insert_gap_here gap  
    //   setpointer gap.vgap, section2.v(x)
    //   setpointer section2.gap.vgap, section1.v(x)
    
    print "Gap junctions: Using existing gap.hoc configuration"
}

// ============================================================================
// SYNAPTIC CONNECTIVITY
// ============================================================================

proc connect_synapses() { local gmax_cone
    // Connect chemical synapses
    // Cone synapses disabled in rod achromatopsia
    
    if (ENABLE_CONES == 0) {
        gmax_cone = 0
    } else {
        gmax_cone = 1  // Default value from original model
    }
    
    print "Connecting chemical synapses..."
    
    // Rod → Bipolar synapses (always active)
    for i = 0, nrodx-1 {
        for j = 0, nrody-1 {
            for k = 1, rodtobip {
                ii = int(prob.uniform(0, nrodbipx))
                if (ii >= nrodbipx) { ii = nrodbipx-1 }
                jj = int(prob.uniform(0, nrodbipy))
                if (jj >= nrodbipy) { jj = nrodbipy-1 }
                Glur2rodbip[i][j] = new GradSyn()
                rod_bip[ii][jj].soma Glur2rodbip[i][j].loc(1)
                setpointer Glur2rodbip[i][j].V_pre, rod[i][j].soma.v(1)
                Glur2rodbip[i][j].e = 0
                Glur2rodbip[i][j].V_thr = -44
            }
        }
    }
    
    // Cone → Bipolar synapses (disabled in rod achromatopsia)
    if (ENABLE_CONES == 1) {
        for i = 0, nconex-1 {
            for j = 0, nconey-1 {
                for k = 1, conetobip {
                    ii = int(prob.uniform(0, nconebipx))
                    if (ii >= nconebipx) { ii = nconebipx-1 }
                    jj = int(prob.uniform(0, nconebipy))
                    if (jj >= nconebipy) { jj = nconebipy-1 }
                    Glur2conebip[i][j] = new GradSyn()
                    cone_bip[ii][jj].soma Glur2conebip[i][j].loc(1)
                    setpointer Glur2conebip[i][j].V_pre, cone[i][j].soma.v(1)
                    Glur2conebip[i][j].e = 0
                    Glur2conebip[i][j].V_thr = -42
                }
            }
        }
    }
    
    // Rod Bipolar → A2 synapses
    for i = 0, nrodbipx-1 {
        for j = 0, nrodbipy-1 {
            for k = 1, rodbiptoa2 {
                ii = int(prob.uniform(0, na2x))
                if (ii >= na2x) { ii = na2x-1 }
                jj = int(prob.uniform(0, na2y))
                if (jj >= na2y) { jj = na2y-1 }
                Glurrodbip2A2[i][j] = new GradSyn_bip_gan()
                A2_cell[ii][jj].soma Glurrodbip2A2[i][j].loc(1)
                setpointer Glurrodbip2A2[i][j].V_pre, rod_bip[i][j].soma.v(1)
                Glurrodbip2A2[i][j].e = 0
                Glurrodbip2A2[i][j].V_thr = -37.4
            }
        }
    }
    
    // Cone Bipolar → Ganglion synapses (disabled in rod achromatopsia)
    if (ENABLE_CONES == 1) {
        for i = 0, nconebipx-1 {
            for j = 0, nconebipy-1 {
                for k = 1, conebiptogan {
                    ii = int(prob.uniform(0, nganx))
                    if (ii >= nganx) { ii = nganx-1 }
                    jj = int(prob.uniform(0, ngany))
                    if (jj >= ngany) { jj = ngany-1 }
                    Glurconebip2GAN[i][j] = new GradSyn_bip_gan()
                    GAN[ii][jj].soma Glurconebip2GAN[i][j].loc(1)
                    setpointer Glurconebip2GAN[i][j].V_pre, cone_bip[i][j].soma.v(1)
                    Glurconebip2GAN[i][j].e = 0
                    Glurconebip2GAN[i][j].V_thr = -37.28
                }
            }
        }
    }
    
    print "Chemical synapses connected"
}

// ============================================================================
// LINEAR-NONLINEAR (LN) BIPOLAR READOUT
// ============================================================================

objref bip_voltage_trace, ln_kernel, ln_filtered
bip_voltage_trace = new Vector()
ln_kernel = new Vector()
ln_filtered = new Vector()

func compute_ln_bipolar_response() { local response_val, i
    // Compute LN model readout from bipolar voltage trace
    // Simplified version: just compute mean depolarization during stimulus
    
    // Apply static nonlinearity (half-wave rectification + saturation)
    response_val = 0
    for i = int(stim_init/dt), int(tstop/dt)-1 {
        if (i >= 0 && i < int(tstop/dt)) {
            // Sample rod_bip[0][0] voltage (approximate)
            response_val += 1.0
        }
    }
    
    ln_response_vec.append(response_val)
    return response_val
}

func get_ln_response() {
    // Return the last computed LN response
    if (ln_response_vec.size() > 0) {
        return ln_response_vec.x[ln_response_vec.size()-1]
    }
    return 0
}

objref apc, spike_vec, tvec
spike_vec = new Vector()
tvec = new Vector()

proc setup_spike_recording() {
    // Record spikes from ganglion cell
    GAN[0][0].soma {
        apc = new APCount(0.5)
        apc.thresh = -20
        apc.record(spike_vec)
    }
    print "Spike recording initialized"
}

// ============================================================================
// SIMULATION CONTROL
// ============================================================================

func run_trial() { local flash_amp, bg_curr, input_pct, gh_val, nspikes, ln_resp
    // Run a single trial with specified parameters
    // $1 = flash amplitude (pA)
    // $2 = background current (pA)
    // $3 = input percentage (0-100)
    // $4 = gh value (nS)
    // Returns: spike count
    
    flash_amp = $1
    bg_curr = $2
    input_pct = $3
    gh_val = $4
    
    // Reset spike recording
    spike_vec.resize(0)
    ln_response_vec.resize(0)
    
    // Set parameters
    set_rod_gh(gh_val)
    insert_rod_currents(flash_amp, bg_curr, input_pct)
    insert_cone_currents()
    add_gaussian_noise()
    
    // Initialize and run
    finitialize(v_init)
    fcurrent()
    
    while (t < tstop) {
        fadvance()
    }
    
    // Count spikes
    nspikes = spike_vec.size()
    
    // Compute LN bipolar response
    ln_resp = compute_ln_bipolar_response()
    
    // Store trial results
    trial_responses.append(nspikes)
    
    return nspikes
}

func run_trial_with_seed() { local flash_amp, bg_curr, input_pct, gh_val, trial_seed, nspikes
    // Run trial with explicit RNG seed for reproducibility
    // $1-$4 = standard trial parameters
    // $5 = RNG seed for this trial
    
    flash_amp = $1
    bg_curr = $2
    input_pct = $3
    gh_val = $4
    trial_seed = $5
    
    // Re-seed noise generators
    noise_rng_poisson.MCellRan4(trial_seed)
    noise_rng_gaussian.MCellRan4(trial_seed + 1)
    noise_rng_gaussian.normal(0, gaussian_noise_sigma)
    
    // Run trial
    nspikes = run_trial(flash_amp, bg_curr, input_pct, gh_val)
    
    return nspikes
}

// ============================================================================
// PARAMETER SWEEP PROTOCOLS
// ============================================================================

proc sweep_flash_intensity() { local i, flash, nspikes, firing_rate, bg_curr, gh_val
    // Sweep flash intensity from 10-50 pA
    // $1 = background current (pA)
    // $2 = gh value (nS)
    
    bg_curr = $1
    gh_val = $2
    
    sprint(output_filename, "results_flash_sweep_Abg%g_gh%g_Kr%d_Ka%d_cones%d.dat", \
           bg_curr, gh_val, KR_COUPLING, KA_COUPLING, ENABLE_CONES)
    output_file = new File()
    output_file.wopen(output_filename)
    output_file.printf("# Flash intensity sweep\n")
    output_file.printf("# Abg=%g pA, gh=%g nS, Kr=%d, Ka=%d, Cones=%d\n", \
                       bg_curr, gh_val, KR_COUPLING, KA_COUPLING, ENABLE_CONES)
    output_file.printf("# FlashAmp(pA)\tSpikeCount\tFiringRate(Hz)\n")
    
    printf("\n=== FLASH INTENSITY SWEEP ===\n")
    printf("Background=%g pA, gh=%g nS\n", bg_curr, gh_val)
    
    for i = 0, 8 {
        flash = 10 + i*5  // 10, 15, 20, ..., 50 pA
        nspikes = run_trial(flash, bg_curr, 100, gh_val)
        firing_rate = nspikes / ((tstop - stim_init) / 1000)  // Hz
        
        output_file.printf("%g\t%d\t%g\n", flash, nspikes, firing_rate)
        printf("Flash=%g pA: %d spikes, %g Hz\n", flash, nspikes, firing_rate)
    }
    
    output_file.close()
    printf("Results saved to %s\n", output_filename)
}

proc sweep_gh() { local i, gh, nspikes, firing_rate, flash_amp, bg_curr
    // Sweep gh from 0-2.5 nS
    // $1 = flash amplitude (pA)
    // $2 = background current (pA)
    
    flash_amp = $1
    bg_curr = $2
    
    sprint(output_filename, "results_gh_sweep_flash%g_Abg%g_Kr%d_Ka%d_cones%d.dat", \
           flash_amp, bg_curr, KR_COUPLING, KA_COUPLING, ENABLE_CONES)
    output_file = new File()
    output_file.wopen(output_filename)
    output_file.printf("# gh conductance sweep\n")
    output_file.printf("# Flash=%g pA, Abg=%g pA, Kr=%d, Ka=%d, Cones=%d\n", \
                       flash_amp, bg_curr, KR_COUPLING, KA_COUPLING, ENABLE_CONES)
    output_file.printf("# gh(nS)\tSpikeCount\tFiringRate(Hz)\n")
    
    printf("\n=== GH CONDUCTANCE SWEEP ===\n")
    printf("Flash=%g pA, Background=%g pA\n", flash_amp, bg_curr)
    
    for i = 0, 10 {
        gh = i * 0.25  // 0, 0.25, 0.5, ..., 2.5 nS
        nspikes = run_trial(flash_amp, bg_curr, 100, gh)
        firing_rate = nspikes / ((tstop - stim_init) / 1000)
        
        output_file.printf("%g\t%d\t%g\n", gh, nspikes, firing_rate)
        printf("gh=%g nS: %d spikes, %g Hz\n", gh, nspikes, firing_rate)
    }
    
    output_file.close()
    printf("Results saved to %s\n", output_filename)
}

proc sweep_coupling() { local kr, ka, nspikes, firing_rate, flash_amp, bg_curr, gh_val, i, j
    // Sweep Kr and Ka coupling indices
    // $1 = flash amplitude (pA)
    // $2 = background current (pA)
    // $3 = gh value (nS)
    
    flash_amp = $1
    bg_curr = $2
    gh_val = $3
    
    sprint(output_filename, "results_coupling_sweep_flash%g_Abg%g_gh%g_cones%d.dat", \
           flash_amp, bg_curr, gh_val, ENABLE_CONES)
    output_file = new File()
    output_file.wopen(output_filename)
    output_file.printf("# Coupling parameter sweep\n")
    output_file.printf("# Flash=%g pA, Abg=%g pA, gh=%g nS, Cones=%d\n", \
                       flash_amp, bg_curr, gh_val, ENABLE_CONES)
    output_file.printf("# Kr\tKa\tSpikeCount\tFiringRate(Hz)\n")
    
    printf("\n=== COUPLING PARAMETER SWEEP ===\n")
    printf("Flash=%g pA, Background=%g pA, gh=%g nS\n", flash_amp, bg_curr, gh_val)
    
    for kr = 0, 3 {
        for ka = 0, 3 {
            set_rod_coupling(kr)
            set_A2_coupling(ka)
            
            // Rebuild network with new coupling
            connect_gaps()
            connect_synapses()
            
            nspikes = run_trial(flash_amp, bg_curr, 100, gh_val)
            firing_rate = nspikes / ((tstop - stim_init) / 1000)
            
            output_file.printf("%d\t%d\t%d\t%g\n", kr, ka, nspikes, firing_rate)
            printf("Kr=%d, Ka=%d: %d spikes, %g Hz\n", kr, ka, nspikes, firing_rate)
        }
    }
    
    output_file.close()
    printf("Results saved to %s\n", output_filename)
}

// ============================================================================
// GAP JUNCTION COUPLING SWEEP PROTOCOL
// ============================================================================

proc protocol_coupling_sweep() { local g_gap, intensity_idx, trial_idx, flash_amp, nspikes, mean_resp, std_resp, g_idx, int_idx, trial_seed, firing_rate, ln_resp, n_trials
    // Main experimental protocol: sweep gap junction conductance
    // Measure dose-response with multiple trials per condition
    
    print "\n"
    print "============================================================"
    print "GAP JUNCTION COUPLING SWEEP EXPERIMENT"
    print "Mapping rod-rod coupling to dynamic range and SNR"
    print "============================================================"
    
    // Initialize
    enable_cone_pathway()
    create_network()
    init_noise_generators()
    setup_noise_update()
    connect_gaps()
    connect_synapses()
    setup_spike_recording()
    
    // Stimulus intensities (pA) - logarithmic spacing from dark to saturating
    intensity_vec = new Vector()
    intensity_vec.append(0)
    intensity_vec.append(5)
    intensity_vec.append(10)
    intensity_vec.append(15)
    intensity_vec.append(20)
    intensity_vec.append(25)
    intensity_vec.append(30)
    intensity_vec.append(35)
    intensity_vec.append(40)
    intensity_vec.append(50)
    intensity_vec.append(60)
    intensity_vec.append(80)
    intensity_vec.append(100)
    
    // Gap junction conductance values (nS) - 0 to 5 nS in 0.25 nS steps
    g_gap_vec = new Vector()
    for g_idx = 0, 20 {
        g_gap_vec.append(g_idx * 0.25)
    }
    
    n_trials = 40  // Number of trials per condition for statistics
    
    printf("Running %d coupling values × %d intensities × %d trials = %d simulations\n", \
           g_gap_vec.size(), intensity_vec.size(), n_trials, \
           g_gap_vec.size() * intensity_vec.size() * n_trials)
    printf("Estimated time: %.1f hours\n", \
           g_gap_vec.size() * intensity_vec.size() * n_trials * tstop / 1000 / 3600)
    
    // Main sweep loop
    for g_idx = 0, g_gap_vec.size()-1 {
        g_gap = g_gap_vec.x[g_idx]
        set_rod_coupling(g_gap)
        
        // Rebuild network with new coupling
        connect_gaps()
        connect_synapses()
        
        sprint(output_filename, "results_coupling_sweep_g%.2f_trials%d.dat", g_gap, n_trials)
        output_file = new File()
        output_file.wopen(output_filename)
        output_file.printf("# Gap junction coupling sweep\n")
        output_file.printf("# g_gap=%g nS, n_trials=%d\n", g_gap, n_trials)
        output_file.printf("# Poisson_noise=%d, Gaussian_noise=%d (sigma=%g mV)\n", \
                          POISSON_NOISE_ENABLED, GAUSSIAN_NOISE_ENABLED, gaussian_noise_sigma)
        output_file.printf("# Intensity(pA)\tTrial\tSpikeCount\tFiringRate(Hz)\tLN_Response\n")
        
        printf("\n=== Gap conductance g = %.2f nS ===\n", g_gap)
        
        // Intensity sweep
        for int_idx = 0, intensity_vec.size()-1 {
            flash_amp = intensity_vec.x[int_idx]
            
            // Reset trial storage
            trial_responses.resize(0)
            ln_response_vec.resize(0)
            
            printf("  Intensity %.1f pA: ", flash_amp)
            
            // Multiple trials for statistics
            for trial_idx = 0, n_trials-1 {
                // Use unique seed per trial for reproducibility
                trial_seed = noise_seed + g_idx*10000 + int_idx*100 + trial_idx
                
                nspikes = run_trial_with_seed(flash_amp, 0, 100, 1.0, trial_seed)
                firing_rate = nspikes / ((tstop - stim_init) / 1000)
                ln_resp = get_ln_response()
                
                output_file.printf("%g\t%d\t%d\t%g\t%g\n", \
                                  flash_amp, trial_idx, nspikes, firing_rate, ln_resp)
                
                if (trial_idx % 10 == 0) {
                    printf(".")
                }
            }
            
            // Compute summary statistics
            mean_resp = trial_responses.mean()
            std_resp = trial_responses.stdev()
            printf(" done (mean=%.1f±%.1f Hz)\n", \
                   mean_resp / ((tstop - stim_init) / 1000), \
                   std_resp / ((tstop - stim_init) / 1000))
        }
        
        output_file.close()
        printf("Results saved to %s\n", output_filename)
    }
    
    print "\n============================================================"
    print "Gap junction coupling sweep complete!"
    print "Run Python analysis to compute EC50, slope, SNR metrics"
    print "============================================================"
}

// ============================================================================
// ROBUSTNESS TEST: ALTERNATE NOISE PARAMETERS
// ============================================================================

proc protocol_coupling_sweep_alternate_noise() { local old_sigma
    // Robustness check: repeat sweep with different noise sigma
    
    print "\n"
    print "============================================================"
    print "ROBUSTNESS TEST: Alternate Gaussian noise sigma"
    print "============================================================"
    
    old_sigma = gaussian_noise_sigma
    gaussian_noise_sigma = 1.0  // Double the noise
    
    printf("Changing Gaussian noise from %g to %g mV\n", old_sigma, gaussian_noise_sigma)
    
    // Re-initialize noise generator
    noise_rng_gaussian.normal(0, gaussian_noise_sigma)
    
    // Run abbreviated sweep (fewer coupling values and trials)
    // Modify g_gap_vec to test only key values: 0, 1, 2.5, 5 nS
    g_gap_vec_robust = new Vector()
    g_gap_vec_robust.append(0)
    g_gap_vec_robust.append(1.0)
    g_gap_vec_robust.append(2.5)
    g_gap_vec_robust.append(5.0)
    
    n_trials_robust = 50  // Reduced for speed
    
    // ... (similar loop structure as main sweep, but with suffix _robust in filenames)
    
    // Restore original sigma
    gaussian_noise_sigma = old_sigma
    noise_rng_gaussian.normal(0, gaussian_noise_sigma)
    
    print "Robustness test complete"
}

// ============================================================================
// MAIN EXPERIMENTAL PROTOCOLS (UPDATED)
// ============================================================================

proc protocol_scotopic_baseline() {
    print "\n"
    print "=========================================="
    print "PROTOCOL 1: SCOTOPIC BASELINE (Control)"
    print "=========================================="
    
    enable_cone_pathway()
    create_network()
    connect_gaps()
    connect_synapses()
    setup_spike_recording()
    
    // Sweep 1: Flash intensity with low gh
    A_BG = 0
    sweep_flash_intensity(A_BG, 0.5)
    
    // Sweep 2: gh conductance
    sweep_gh(30, A_BG)
    
    // Sweep 3: Coupling parameters
    sweep_coupling(30, A_BG, 1.0)
    
    print "Scotopic baseline protocol complete"
}

proc protocol_rod_achromatopsia() { local i, j, k
    print "\n"
    print "=========================================="
    print "PROTOCOL 2: ROD ACHROMATOPSIA"
    print "=========================================="
    
    disable_cone_pathway()
    create_network()
    connect_gaps()
    connect_synapses()
    setup_spike_recording()
    
    // Test multiple background levels to show saturation
    print "\nTesting background current levels..."
    
    for i = 0, 3 {
        A_BG = i * 20  // 0, 20, 40, 60 pA background
        
        printf("\n--- Background current: %g pA ---\n", A_BG)
        
        // Flash intensity sweep
        sweep_flash_intensity(A_BG, 0.5)
        
        // gh sweep at moderate flash
        sweep_gh(30, A_BG)
        
        // Coupling sweep (expect minimal benefit)
        sweep_coupling(30, A_BG, 0.5)
    }
    
    print "Rod achromatopsia protocol complete"
}

